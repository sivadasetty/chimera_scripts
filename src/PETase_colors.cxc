set bgColor #FFFFFF
#set bcColor #000000

hide #1 atoms

show #1 cartoons
color #1 steelblue
cartoon style width 1.5 thickness 0.3 arrows true

select ::name="UNK"
show sel atoms
style sel stick
size stickRadius 0.20
color sel green
color sel byhetero

select :132,178,209
show sel atoms
style sel stick
size stickRadius 0.24
color sel gold
color sel byhetero

select clear
